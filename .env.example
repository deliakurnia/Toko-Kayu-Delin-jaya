# ===================================================================
# Toko Kayu Delin Jaya - Frontend Environment Configuration (Template)
# PENTING: Salin berkas ini menjadi .env.local untuk pengembangan lokal.
# DILARANG commit berkas .env / .env.local asli ke GitHub!
# ===================================================================

# Gemini AI API Key (Opsional - untuk konsultasi AI arsitektur/furnitur)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Base Application URL
APP_URL="http://localhost:3000"

# Midtrans Payment Gateway Client Key (Frontend)
# Client Key aman di frontend, didapat dari dashboard.midtrans.com
VITE_MIDTRANS_CLIENT_KEY=Mid-client-your-client-key-here
VITE_MIDTRANS_IS_PRODUCTION=false

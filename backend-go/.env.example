# ===================================================================
# Toko Kayu Delin Jaya - Backend Environment Configuration (Template)
# PENTING: Salin berkas ini menjadi .env lalu isi dengan kredensial asli.
# DILARANG commit berkas .env asli ke GitHub!
# ===================================================================

# MongoDB Atlas Connection URI (M0 Free Tier / Local MongoDB)
# Format: mongodb+srv://<username>:<password>@cluster0.your-cluster.mongodb.net/kayu_nusantara?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.your-cluster.mongodb.net/kayu_nusantara?retryWrites=true&w=majority

# Database Name
MONGO_DB_NAME=kayu_nusantara

# Owner WhatsApp Business Number (Format internasional tanpa simbol +, contoh: 6285891917286)
OWNER_WHATSAPP=6285891917286

# Port Server Backend Go
PORT=8080

# Midtrans Payment Gateway Configuration
# Dapatkan Server Key & Client Key dari Dashboard Midtrans (https://dashboard.midtrans.com)
MIDTRANS_SERVER_KEY=Mid-server-your-server-key-here
MIDTRANS_CLIENT_KEY=Mid-client-your-client-key-here
MIDTRANS_IS_PRODUCTION=false
